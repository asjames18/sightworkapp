# Copy to .env.local and fill in locally. Never commit real values.
# All keys are read server-side from process.env only.

# Baseten key for Muse Spark Open, the default engine for the plan (reason) step.
BASETEN_API_KEY=

# Which provider runs the plan step on the server: "baseten" (default) or "meta".
PLAN_PROVIDER=baseten

# Meta Model API key, used for voice transcribe, SAM 3.1 masks and the Muse Image
# after picture (MODEL_API_KEY works too). Steps whose model isn't reachable are skipped.
META_API_KEY=

# Which plan runner the browser uses: "mock" (default, no network) or "api" (POST /api/plan).
# A page URL with ?runner=api or ?runner=mock overrides this for previews.
NEXT_PUBLIC_SIGHTWORK_RUNNER=mock

# Which plan engine the processing screen names: "baseten" or "meta" (unset means "meta",
# so keep this matching PLAN_PROVIDER).
# A page URL with ?plan=baseten or ?plan=meta overrides this for previews.
NEXT_PUBLIC_SIGHTWORK_PLAN_PROVIDER=baseten

# Largest plan request the browser builds, in bytes (build time). Leave blank for 9 MB (the route
# caps at 10 MB). On Vercel, where function bodies cap at 4.5 MB, use about 4300000 so long takes
# send softer frames or get the "too long" message instead of a platform 413. 1048576 to 9437184.
NEXT_PUBLIC_SIGHTWORK_MAX_REQUEST_BYTES=

# How many SAM 3.1 calls the segment step keeps in flight at once. Leave blank for the
# default (4). A whole number >= 1 overrides it; anything else stops the run before any step.
SEGMENT_CONCURRENCY=

# Shared tester code. Real runs (which spend model credits) must send it in the
# x-sightwork-test-code header; without it the API answers 401. Never commit the value.
SIGHTWORK_TEST_CODE=

# Paid plans (off by default). "on" turns on checkout and paid access codes on the server.
SIGHTWORK_BILLING=
# Secret that signs paid access codes (at least 32 random characters). Never commit the value.
SIGHTWORK_ACCESS_SECRET=
# Stripe secret or restricted key for the mode you run in (test key outside production). Never commit it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email for "find my purchase": Brevo transactional API key (or RESEND_API_KEY) plus the sender,
# e.g. SightWork <no-reply@example.com> on a domain verified with the mail service. Without them, recovery answers 503.
BREVO_API_KEY=
RESEND_API_KEY=
SIGHTWORK_MAIL_FROM=
# Stripe price ids (price_...) for each paid plan, from the same Stripe mode as the key above.
SIGHTWORK_PRICE_SINGLE=
SIGHTWORK_PRICE_PACK5=
SIGHTWORK_PRICE_CHURCH_MONTHLY=
SIGHTWORK_PRICE_CHURCH_YEARLY=
SIGHTWORK_PRICE_MINISTRY_MONTHLY=
SIGHTWORK_PRICE_MINISTRY_YEARLY=
SIGHTWORK_PRICE_MULTISITE_MONTHLY=
SIGHTWORK_PRICE_MULTISITE_YEARLY=
